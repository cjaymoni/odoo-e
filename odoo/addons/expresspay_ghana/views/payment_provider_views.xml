<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="payment_provider_form_expresspay" model="ir.ui.view">
    <field name="name">ExpressPay Provider Form</field>
    <field name="model">payment.provider</field>
    <field name="inherit_id" ref="payment.payment_provider_form"/>
    <field name="arch" type="xml">
      <group name="provider_credentials" position="inside">
        <group name="expresspay_credentials" invisible="code!='expresspay'">
          <field name="expresspay_merchant_id"/>
          <field name="expresspay_api_key" password="True"/>
          <field name="expresspay_base_url"/>
          <field name="expresspay_enable_webhooks"/>
          <field name="expresspay_fallback_polling" invisible="expresspay_enable_webhooks"/>
        </group>
      </group>
    </field>
  </record>
</odoo>