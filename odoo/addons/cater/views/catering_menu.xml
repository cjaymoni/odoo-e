              sequence="20"
              groups="catering_event_planner_group,catering_staff_group,catering_manager_group"/>

    <!-- Packages (directly under Event Planning) -->
    <menuitem id="catering_packages_menu" 
              name="Packages" 
              parent="catering_event_planner_menu" 
              action="catering_package_action" 
              sequence="20"
              groups="catering_event_planner_group,catering_staff_group,catering_manager_group"/>

    <!-- Services (directly under Event Planning) -->
    <menuitem id="catering_services_menu" 
              name="Services" 
              parent="catering_event_planner_menu" 
              action="catering_service_action" 
              sequence="30"
              groups="catering_event_planner_group,catering_staff_group,catering_manager_group"/>

