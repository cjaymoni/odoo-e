              name="Configuration" 
              parent="catering_whatsapp_menu" 
              action="catering_whatsapp_service_action" 
              sequence="10"
              groups="catering_manager_group"/>
              
    <menuitem id="catering_whatsapp_logs" 
              name="Message Logs" 
              parent="catering_whatsapp_menu" 
              action="catering_whatsapp_log_action" 
              sequence="20"
              groups="catering_manager_group"/>
</odoo>