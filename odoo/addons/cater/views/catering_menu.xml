    <!-- ========================================= -->
    
    <menuitem id="catering_event_planner_menu" 
              name="Event Planning" 
              parent="catering_main_menu" 
              sequence="5"
              groups="catering_event_planner_group,catering_staff_group,catering_manager_group"/>

    <!-- Bookings Sub-Menu -->
    <menuitem id="catering_bookings_menu" 
              name="Bookings" 
              parent="catering_event_planner_menu" 
              sequence="10"
              groups="catering_event_planner_group,catering_staff_group,catering_manager_group"/>
              
    <menuitem id="catering_bookings_all" 
              name="Events" 
              parent="catering_bookings_menu" 
              action="catering_event_booking_action" 
              sequence="10"
              groups="catering_event_planner_group,catering_staff_group,catering_manager_group"/>
              
    <menuitem id="catering_bookings_today" 
