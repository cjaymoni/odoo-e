<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Catering CRM Team -->
        <record id="crm_team_catering" model="crm.team">
            <field name="name">Catering Sales</field>
            <field name="use_leads">True</field>
            <field name="use_opportunities">True</field>
            <field name="alias_name">catering.leads</field>
            <field name="sequence">10</field>
        </record>

        <!-- Custom Lead Stages for Catering -->
        <record id="stage_lead_inquiry" model="crm.stage">
            <field name="name">Inquiry</field>
            <field name="sequence">1</field>
            <field name="team_id" ref="crm_team_catering"/>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="False"/>
        </record>

        <record id="stage_lead_consultation" model="crm.stage">
            <field name="name">Consultation Scheduled</field>
            <field name="sequence">2</field>
            <field name="team_id" ref="crm_team_catering"/>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="False"/>
        </record>

        <record id="stage_lead_proposal" model="crm.stage">
            <field name="name">Proposal Sent</field>
            <field name="sequence">3</field>
            <field name="team_id" ref="crm_team_catering"/>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="False"/>
        </record>

        <record id="stage_lead_negotiation" model="crm.stage">
            <field name="name">Negotiation</field>
            <field name="sequence">4</field>
            <field name="team_id" ref="crm_team_catering"/>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="False"/>
        </record>

        <record id="stage_lead_won" model="crm.stage">
            <field name="name">Won</field>
            <field name="sequence">5</field>
            <field name="team_id" ref="crm_team_catering"/>
            <field name="fold" eval="False"/>
            <field name="is_won" eval="True"/>
        </record>

        <record id="stage_lead_lost" model="crm.stage">
            <field name="name">Lost</field>
            <field name="sequence">6</field>
            <field name="team_id" ref="crm_team_catering"/>
            <field name="fold" eval="True"/>
            <field name="is_won" eval="False"/>
        </record>

        <!-- Lead Tags for Catering -->
        <record id="tag_catering_inquiry" model="crm.tag">
            <field name="name">Catering Inquiry</field>
            <field name="color">2</field>
        </record>

        <record id="tag_corporate_event" model="crm.tag">
            <field name="name">Corporate Event</field>
            <field name="color">3</field>
        </record>

        <record id="tag_wedding" model="crm.tag">
            <field name="name">Wedding</field>
            <field name="color">5</field>
        </record>

        <record id="tag_private_party" model="crm.tag">
            <field name="name">Private Party</field>
            <field name="color">1</field>
        </record>

        <record id="tag_high_value" model="crm.tag">
            <field name="name">High Value (>$5000)</field>
            <field name="color">6</field>
        </record>

        <record id="tag_urgent" model="crm.tag">
            <field name="name">Urgent Request</field>
            <field name="color">9</field>
        </record>

    </data>
</odoo>
