<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Ghana VAT 15% for Sales -->
        <record id="ghana_vat_sale_15" model="account.tax">
            <field name="name">VAT 15% (Ghana)</field>
            <field name="description">VAT 15%</field>
            <field name="amount_type">percent</field>
            <field name="amount">15.0</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="account.tax_group_taxes"/>
            <field name="price_include" eval="False"/>
            <field name="include_base_amount" eval="False"/>
            <field name="active" eval="True"/>
            <field name="sequence">10</field>
        </record>

        <!-- Ghana VAT 15% for Purchases -->
        <record id="ghana_vat_purchase_15" model="account.tax">
            <field name="name">VAT 15% (Ghana) - Purchase</field>
            <field name="description">VAT 15%</field>
            <field name="amount_type">percent</field>
            <field name="amount">15.0</field>
            <field name="type_tax_use">purchase</field>
            <field name="tax_group_id" ref="account.tax_group_taxes"/>
            <field name="price_include" eval="False"/>
            <field name="include_base_amount" eval="False"/>
            <field name="active" eval="True"/>
            <field name="sequence">10</field>
        </record>
    </data>
</odoo>
