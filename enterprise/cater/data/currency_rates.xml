<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Initial Exchange Rates for Ghana Cedis (GHS) -->
        
        <!-- USD Exchange Rate -->
        <record id="currency_rate_ghs_usd" model="cater.currency.rate">
            <field name="date" eval="(datetime.now() - timedelta(days=365)).strftime('%Y-%m-%d')"/>
            <field name="currency_id" ref="base.USD"/>
            <field name="rate">0.082</field>
            <field name="active">True</field>
        </record>
        
        <!-- GBP Exchange Rate -->
        <record id="currency_rate_ghs_gbp" model="cater.currency.rate">
            <field name="date" eval="(datetime.now() - timedelta(days=365)).strftime('%Y-%m-%d')"/>
            <field name="currency_id" ref="base.GBP"/>
            <field name="rate">0.063</field>
            <field name="active">True</field>
        </record>
        
        <!-- EUR Exchange Rate (optional) -->
        <record id="currency_rate_ghs_eur" model="cater.currency.rate">
            <field name="date" eval="(datetime.now() - timedelta(days=365)).strftime('%Y-%m-%d')"/>
            <field name="currency_id" ref="base.EUR"/>
            <field name="rate">0.075</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
