<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Catering Service Views -->
    <record id="catering_service_list_view" model="ir.ui.view">
        <field name="name">cater.service.list</field>
        <field name="model">cater.service</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="service_type"/>
                <field name="price" widget="monetary"/>
                <field name="duration" widget="float_time"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="catering_service_form_view" model="ir.ui.view">
        <field name="name">cater.service.form</field>
        <field name="model">cater.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Service Name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="basic_info">
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="service_type"/>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                        <group name="status">
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="description" placeholder="Service description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="catering_service_action" model="ir.actions.act_window">
        <field name="name">Catering Services</field>
        <field name="res_model">cater.service</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
