<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Customer Request Tree View -->
    <record id="view_customer_request_tree" model="ir.ui.view">
        <field name="name">cater.customer.request.tree</field>
        <field name="model">cater.customer.request</field>
        <field name="arch" type="xml">
            <list string="Customer Requests" decoration-info="state=='new'" 
                  decoration-success="state=='converted'" decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="event_type"/>
                <field name="event_date"/>
                <field name="guest_count"/>
                <field name="budget_range"/>
                <field name="priority" widget="priority"/>
                <field name="state" decoration-info="state=='new'" 
                       decoration-success="state=='converted'" decoration-warning="state=='qualified'"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Customer Request Form View -->
    <record id="view_customer_request_form" model="ir.ui.view">
        <field name="name">cater.customer.request.form</field>
        <field name="model">cater.customer.request</field>
        <field name="arch" type="xml">
            <form string="Customer Request">
                <header>
                    <button name="action_contact" string="Mark Contacted" type="object" 
                            class="oe_highlight" invisible="state not in ['new']"/>
                    <button name="action_qualify" string="Qualify" type="object" 
                            class="oe_highlight" invisible="state not in ['new', 'contacted']"/>
                    <button name="action_create_lead" string="Convert to Lead" type="object" 
                            class="oe_highlight" invisible="state not in ['qualified'] or lead_id"/>
                    <button name="action_cancel" string="Cancel" type="object" 
                            invisible="state in ['converted', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,contacted,qualified,converted"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lead" type="object" 
                                class="oe_stat_button" icon="fa-star" 
                                invisible="not lead_id">
                            <field name="lead_count" widget="statinfo" string="Lead"/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="partner_id" widget="res_partner_many2one" 
                                   options="{'always_reload': True}" 
                                   context="{'show_address': 1, 'show_email': 1, 'show_phone': 1}"/>
                            <field name="partner_email"/>
                            <field name="partner_phone"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="priority" widget="priority"/>
                            <field name="expected_revenue" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <group string="Event Information">
                        <group>
                            <field name="event_type"/>
                            <field name="event_date"/>
                            <field name="guest_count"/>
                        </group>
                        <group>
                            <field name="service_type"/>
                            <field name="venue_location"/>
                            <field name="budget_range"/>
                        </group>
                    </group>
                    
                    <group string="Package &amp; Menu Preferences">
                        <group>
                            <field name="package_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="menu_item_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Request Details">
                            <field name="description" placeholder="Enter customer's request details, special requirements, dietary restrictions, etc."/>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes" placeholder="Internal notes for sales team..."/>
                        </page>
                        <page string="History">
                            <group>
                                <group>
                                    <field name="create_date" readonly="1"/>
                                    <field name="contacted_date" readonly="1"/>
                                </group>
                                <group>
                                    <field name="converted_date" readonly="1"/>
                                    <field name="lead_id" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Customer Request Kanban View -->
    <record id="view_customer_request_kanban" model="ir.ui.view">
        <field name="name">cater.customer.request.kanban</field>
        <field name="model">cater.customer.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="event_type"/>
                <field name="event_date"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="partner_id"/>
                                    </strong>
                                    <br/>
                                    <span class="o_kanban_record_subtitle">
                                        <field name="event_type"/>
                                        <t t-if="record.event_date.raw_value"> - <field name="event_date"/></t>
                                    </span>
                                </div>
                                <div class="o_dropdown_kanban dropdown">
                                    <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="description" widget="html" class="oe_kanban_text_gray"/>
                                <div class="text-muted">
                                    <t t-if="record.guest_count.raw_value">
                                        <i class="fa fa-users"/> <field name="guest_count"/> guests
                                    </t>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="priority" widget="priority"/>
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Customer Request Search View -->
    <record id="view_customer_request_search" model="ir.ui.view">
        <field name="name">cater.customer.request.search</field>
        <field name="model">cater.customer.request</field>
        <field name="arch" type="xml">
            <search string="Customer Requests">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="event_type"/>
                <field name="event_date"/>
                <field name="user_id"/>
                
                <filter string="New" name="filter_new" domain="[('state', '=', 'new')]"/>
                <filter string="Contacted" name="filter_contacted" domain="[('state', '=', 'contacted')]"/>
                <filter string="Qualified" name="filter_qualified" domain="[('state', '=', 'qualified')]"/>
                <filter string="Converted" name="filter_converted" domain="[('state', '=', 'converted')]"/>
                
                <separator/>
                <filter string="High Priority" name="filter_high_priority" domain="[('priority', 'in', ['2', '3'])]"/>
                <filter string="Urgent" name="filter_urgent" domain="[('priority', '=', '3')]"/>
                
                <separator/>
                <filter string="This Week" name="filter_this_week" 
                        domain="[('event_date', '&gt;=', (context_today() - relativedelta(weeks=0, weekday=0)).strftime('%Y-%m-%d')),
                                 ('event_date', '&lt;=', (context_today() + relativedelta(weeks=0, weekday=6)).strftime('%Y-%m-%d'))]"/>
                <filter string="Next 30 Days" name="filter_next_30" 
                        domain="[('event_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('event_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                
                <separator/>
                <filter string="My Requests" name="filter_my_requests" domain="[('user_id', '=', uid)]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Event Type" name="group_by_event_type" context="{'group_by': 'event_type'}"/>
                    <filter string="Assigned To" name="group_by_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Source" name="group_by_source" context="{'group_by': 'source'}"/>
                    <filter string="Budget Range" name="group_by_budget" context="{'group_by': 'budget_range'}"/>
                    <filter string="Event Date" name="group_by_event_date" context="{'group_by': 'event_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Customer Request Action -->
    <record id="action_customer_request" model="ir.actions.act_window">
        <field name="name">Customer Requests</field>
        <field name="res_model">cater.customer.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_customer_request_search"/>
        <field name="context">{'search_default_filter_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new customer request
            </p>
            <p>
                Customer requests are initial inquiries that can be converted to CRM leads.
                Track and qualify incoming requests before converting them to opportunities.
            </p>
        </field>
    </record>

    <!-- Sequence for Customer Request -->
    <record id="sequence_customer_request" model="ir.sequence">
        <field name="name">Customer Request</field>
        <field name="code">cater.customer.request</field>
        <field name="prefix">REQ</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
