<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Event Booking list View -->
    <record id="catering_event_booking_list_view" model="ir.ui.view">
        <field name="name">cater.event.booking.list</field>
        <field name="model">cater.event.booking</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='draft'" 
                  decoration-success="state=='confirmed'" 
                  decoration-warning="state=='in_progress'"
                  decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="event_name"/>
                <field name="event_type"/>
                <field name="package_id" optional="show"/>
                <field name="event_date"/>
                <field name="venue"/>
                <field name="guest_count"/>
                <field name="total_amount" widget="monetary"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="feedback_received" string="Feedback" widget="boolean_toggle"/>
                <field name="state" widget="badge" 
                       decoration-info="state=='draft'"
                       decoration-success="state=='confirmed'"
                       decoration-warning="state=='in_progress'"
                       decoration-muted="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Event Booking Form View -->
    <record id="catering_event_booking_form_view" model="ir.ui.view">
        <field name="name">cater.event.booking.form</field>
        <field name="model">cater.event.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm Booking" 
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start_event" type="object" string="Start Event" 
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_complete" type="object" string="Complete Event" 
                            class="btn-success" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel" 
                            class="btn-secondary" invisible="state not in ['draft', 'confirmed']"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,confirmed,in_progress,completed"/>
                </header>
                
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Booking Reference"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="basic_info">
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="partner_id" options="{'create': true, 'create_edit': true}"/>
                            <field name="partner_mobile" placeholder="e.g., +23324XXXXXXX"/>
                            <field name="event_name"/>
                            <field name="event_type"/>
                            <field name="event_date"/>
                            <field name="event_duration"/>
                        </group>
                        <group name="venue_info">
                            <field name="venue"/>
                            <field name="venue_address"/>
                            <field name="guest_count"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <!-- Package Selection Section -->
                    <group string="📦 Package Selection (Optional)" name="package_section">
                        <field name="package_id" 
                               options="{'no_create': True}" 
                               domain="[('active','=',True), ('company_id','=',company_id)]"
                               placeholder="Select a package to auto-fill menu and services..."
                               help="Choose a pre-configured package to automatically populate menu items and services. You can modify them afterwards."/>
                    </group>
                    
                    <notebook>
                        <page string="Menu Items" name="menu_items">
                            <field name="menu_line_ids">
                                <list editable="bottom">
                                    <field name="menu_item_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="subtotal" widget="monetary" sum="Total"/>
                                    <field name="notes"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Additional Services" name="services">
                            <field name="service_line_ids">
                                <list editable="bottom">
                                    <field name="service_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="subtotal" widget="monetary" sum="Total"/>
                                    <field name="notes"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Special Requirements" name="requirements">
                            <group>
                                <field name="special_requests" nolabel="1" placeholder="Any special requests for the event..."/>
                                <field name="dietary_restrictions" nolabel="1" placeholder="Dietary restrictions or allergies..."/>
                            </group>
                        </page>
                        
                        <page string="Communication" name="communication">
                            <group>
                                <group string="WhatsApp Notifications">
                                    <field name="whatsapp_sent"/>
                                    <field name="last_whatsapp_date"/>
                                </group>
                                <group string="Feedback Tracking">
                                    <field name="feedback_request_sent"/>
                                    <field name="feedback_request_date"/>
                                    <field name="feedback_received"/>
                                    <field name="feedback_confirmed"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    
                    <group class="oe_subtotal_footer oe_right">
                        <field name="menu_total" widget="monetary"/>
                        <field name="service_total" widget="monetary"/>
                        <field name="subtotal" widget="monetary"/>
                        <field name="tax_amount" widget="monetary"/>
                        <div class="oe_subtotal_footer_separator">
                            <field name="total_amount" widget="monetary" class="oe_subtotal_footer_total"/>
                        </div>
                        <field name="manual_total_override" widget="boolean_toggle"/>
                        <field name="deposit_amount" widget="monetary"/>
                        <field name="paid_amount" widget="monetary" style="width: 300px;"/>
                        <field name="balance_due" widget="monetary" style="width: 300px;"/>
                    </group>
                </sheet>
                
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Event Booking Kanban View -->
    <record id="catering_event_booking_kanban_view" model="ir.ui.view">
        <field name="name">cater.event.booking.kanban</field>
        <field name="model">cater.event.booking</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" quick_create="false">
                <!-- Define colors for each state -->
                <field name="state"/>
                <field name="partner_id"/>
                <field name="event_name"/>
                <field name="event_date"/>
                <field name="venue"/>
                <field name="guest_count"/>
                <field name="total_amount"/>
                <field name="balance_due"/>
                <field name="event_type"/>
                <field name="company_id"/>
                <field name="color"/>
                <field name="package_id"/>
                
                <!-- Progress bar showing state distribution -->
                <progressbar field="state" colors='{"draft": "info", "confirmed": "success", "in_progress": "warning", "completed": "success", "cancelled": "danger"}'/>
                
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click">
                            <div class="o_dropdown_kanban dropdown">
                                <!-- Contextual dropdown menu -->
                                <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                    <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                    <div class="dropdown-divider"/>
                                    <a name="action_send_confirmation" type="object" class="dropdown-item" t-if="record.state.raw_value == 'confirmed'">
                                        <i class="fa fa-envelope"/> Send Confirmation
                                    </a>
                                    <a name="action_view_invoice" type="object" class="dropdown-item" t-if="record.state.raw_value in ['confirmed', 'in_progress', 'completed']">
                                        <i class="fa fa-file-text-o"/> View Invoice
                                    </a>
                                    <a name="action_create_invoice" type="object" class="dropdown-item" t-if="record.state.raw_value == 'confirmed' and record.balance_due.raw_value > 0">
                                        <i class="fa fa-money"/> Create Invoice
                                    </a>
                                    <div class="dropdown-divider"/>
                                    <ul class="oe_kanban_colorpicker" data-field="color"/>
                                </div>
                            </div>
                            
                            <!-- Card Header -->
                            <div class="oe_kanban_content">
                                <!-- Event Badge -->
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <span><field name="name"/></span>
                                        </strong>
                                        <br/>
                                        <span class="o_kanban_record_subtitle">
                                            <field name="event_name"/>
                                        </span>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <!-- Event Type Badge -->
                                        <span t-if="record.event_type.raw_value" class="badge rounded-pill" 
                                              style="right: 0; position: absolute; margin-right: 1rem;"
                                              t-attf-class="badge rounded-pill {{
                                                  record.event_type.raw_value == 'wedding' ? 'text-bg-danger' :
                                                  record.event_type.raw_value == 'corporate' ? 'text-bg-primary' :
                                                  record.event_type.raw_value == 'birthday' ? 'text-bg-warning' :
                                                  record.event_type.raw_value == 'anniversary' ? 'text-bg-info' :
                                                  'text-bg-secondary'
                                              }}">
                                            <field name="event_type"/>
                                        </span>
                                    </div>
                                </div>
                                
                                <!-- Customer Info -->
                                <div class="o_kanban_record_body">
                                    <div class="row mb-1">
                                        <div class="col-12">
                                            <i class="fa fa-user-circle-o"/> <field name="partner_id"/>
                                        </div>
                                    </div>
                                    
                                    <!-- Event Details -->
                                    <div class="row mb-1">
                                        <div class="col-12">
                                            <i class="fa fa-calendar"/> <field name="event_date" widget="date"/>
                                        </div>
                                    </div>
                                    
                                    <div class="row mb-1" t-if="record.venue.raw_value">
                                        <div class="col-12">
                                            <i class="fa fa-map-marker"/> <field name="venue"/>
                                        </div>
                                    </div>
                                    
                                    <div class="row mb-2">
                                        <div class="col-6">
                                            <i class="fa fa-users"/> <field name="guest_count"/> guests
                                        </div>
                                        <div class="col-6 text-end">
                                            <strong class="text-success">
                                                <field name="total_amount" widget="monetary"/>
                                            </strong>
                                        </div>
                                    </div>
                                    
                                    <!-- Package Indicator -->
                                    <div t-if="record.package_id.raw_value" class="alert alert-info py-1 mb-2" role="alert">
                                        <small><i class="fa fa-cube"/> Package: <field name="package_id"/></small>
                                    </div>
                                    
                                    <!-- Balance Due Warning -->
                                    <div t-if="record.balance_due.raw_value > 0" class="alert alert-warning py-1 mb-2" role="alert">
                                        <small><i class="fa fa-exclamation-triangle"/> Balance: <field name="balance_due" widget="monetary"/></small>
                                    </div>
                                </div>
                                
                                <!-- Quick Action Buttons -->
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <!-- Company indicator -->
                                        <field name="company_id" widget="many2one_avatar_user" invisible="1"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <!-- State-based action buttons -->
                                        <button name="action_confirm" type="object" 
                                                class="btn btn-sm btn-success"
                                                t-if="record.state.raw_value == 'draft'"
                                                title="Confirm Booking">
                                            <i class="fa fa-check"/> Confirm
                                        </button>
                                        
                                        <button name="action_start_event" type="object" 
                                                class="btn btn-sm btn-warning"
                                                t-if="record.state.raw_value == 'confirmed'"
                                                title="Start Event">
                                            <i class="fa fa-play"/> Start
                                        </button>
                                        
                                        <button name="action_complete" type="object" 
                                                class="btn btn-sm btn-primary"
                                                t-if="record.state.raw_value == 'in_progress'"
                                                title="Complete Event">
                                            <i class="fa fa-check-circle"/> Complete
                                        </button>
                                        
                                        <button name="action_cancel" type="object" 
                                                class="btn btn-sm btn-danger"
                                                t-if="record.state.raw_value in ['draft', 'confirmed']"
                                                title="Cancel Booking">
                                            <i class="fa fa-times"/> Cancel
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Event Booking Search View -->
    <record id="catering_event_booking_search_view" model="ir.ui.view">
        <field name="name">cater.event.booking.search</field>
        <field name="model">cater.event.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="event_name"/>
                <field name="venue"/>
                <field name="event_type"/>
                <separator/>
                
                <!-- Status Filters -->
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                
                <!-- Time-based Filters -->
                <filter string="Today" name="today" domain="[]" context="{'cater_filter_today': 1}"/>
                <filter string="Tomorrow" name="tomorrow" domain="[]" context="{'cater_filter_tomorrow': 1}"/>
                <filter string="This Week" name="this_week_events" domain="[]" context="{'cater_filter_this_week': 1}"/>
                <filter string="Next 30 Days" name="upcoming_bookings" domain="[]" context="{'cater_filter_next_30': 1}"/>
                <filter string="Next Week" name="next_week" domain="[]" context="{'cater_filter_next_week': 1}"/>
                <filter string="This Month" name="this_month" domain="[]" context="{'cater_filter_this_month': 1}"/>
                <separator/>
                
                <!-- Confirmation Status Filters -->
                <filter string="Pending Confirmations" name="pending_confirmations" 
                        domain="[('state','=','draft')]"/>
                <separator/>
                
                <!-- Business Filters -->
                <filter string="Large Events (50+ guests)" name="large_events" domain="[('guest_count','&gt;=',50)]"/>
                <filter string="High Value (GHS 5000+)" name="high_value" domain="[('total_amount','&gt;=',5000)]"/>
                <filter string="Unpaid Balance" name="unpaid" domain="[('balance_due','&gt;',0)]"/>
                <separator/>
                
                <!-- Advanced Grouping -->
                <group expand="1" string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by':'state'}" 
                            help="Group bookings by their current status (Draft, Confirmed, In Progress, Completed, Cancelled)"/>
                    <filter string="Status ▸ Pending" name="group_by_status_pending" context="{'group_by':'state'}"
                        domain="[('state','=','draft')]"/>
                    <filter string="Status ▸ Confirmed" name="group_by_status_confirmed" context="{'group_by':'state'}"
                        domain="[('state','=','confirmed')]"/>
                    <filter string="Status ▸ Completed" name="group_by_status_completed" context="{'group_by':'state'}"
                        domain="[('state','=','completed')]"/>
                    <filter string="Event Type" name="group_by_event_type" context="{'group_by':'event_type'}"
                            help="Group bookings by event type (Wedding, Corporate, Birthday, etc)"/>
                    <filter string="Service Type" name="group_by_service_type" context="{'group_by':'service_type_group'}"
                        help="Group bookings by their dominant service type (Equipment, Staff, etc)"/>
                    <separator/>
                    <filter string="Customer" name="group_customer" context="{'group_by':'partner_id'}"/>
                    <filter string="Event Date" name="group_date" context="{'group_by':'event_date:day'}"/>
                    <filter string="Venue" name="group_venue" context="{'group_by':'venue'}"/>
                    <filter string="Month" name="group_month" context="{'group_by':'event_date:month'}"/>
                    <filter string="Week" name="group_week" context="{'group_by':'event_date:week'}"/>
                    <filter string="Year" name="group_year" context="{'group_by':'event_date:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Event Booking Action -->
    <record id="catering_event_booking_action" model="ir.actions.act_window">
        <field name="name">Event Bookings</field>
        <field name="res_model">cater.event.booking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="catering_event_booking_search_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first event booking!
            </p>
            <p>
                Manage all your catering bookings from weddings to corporate events.
                Track customer details, menu selections, and pricing all in one place.
            </p>
        </field>
    </record>

    <!-- Today's Events Action -->
    <record id="catering_event_booking_today_action" model="ir.actions.act_window">
        <field name="name">Today's Events</field>
        <field name="res_model">cater.event.booking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

    <!-- Upcoming Bookings Action (Next 30 Days) -->
    <record id="catering_event_booking_upcoming_action" model="ir.actions.act_window">
        <field name="name">Upcoming Bookings</field>
        <field name="res_model">cater.event.booking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_upcoming_bookings': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No upcoming bookings in the next 30 days!
            </p>
            <p>
                This view shows all events scheduled for the next 30 days.
                Stay on top of your upcoming commitments and prepare accordingly.
            </p>
        </field>
    </record>

    <!-- This Week's Events Action -->
    <record id="catering_event_booking_this_week_action" model="ir.actions.act_window">
        <field name="name">This Week's Events</field>
        <field name="res_model">cater.event.booking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_this_week_events': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No events scheduled for this week!
            </p>
            <p>
                This view displays all events scheduled for the current week.
                Focus on this week's deliverables and ensure everything is ready.
            </p>
        </field>
    </record>

    <!-- Pending Confirmations Action -->
    <record id="catering_event_booking_pending_action" model="ir.actions.act_window">
        <field name="name">Pending Confirmations</field>
        <field name="res_model">cater.event.booking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_pending_confirmations': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                All bookings are confirmed!
            </p>
            <p>
                This view shows all event bookings that are awaiting confirmation.
                Review and confirm bookings to move them forward in the workflow.
            </p>
        </field>
    </record>

    <!-- Bookings Grouped by Status Action -->
    <record id="catering_event_booking_by_status_action" model="ir.actions.act_window">
        <field name="name">Bookings by Status</field>
        <field name="res_model">cater.event.booking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_by_status': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bookings found!
            </p>
            <p>
                This view organizes all bookings grouped by their status.
                Quickly see how many bookings are pending, confirmed, in progress, or completed.
            </p>
        </field>
    </record>

    <!-- Bookings Grouped by Event Type Action -->
    <record id="catering_event_booking_by_event_type_action" model="ir.actions.act_window">
        <field name="name">Bookings by Event Type</field>
        <field name="res_model">cater.event.booking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_by_event_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No bookings found!
            </p>
            <p>
                This view organizes all bookings grouped by event type.
                See your bookings organized by Wedding, Corporate, Birthday, and other event categories.
            </p>
        </field>
    </record>
</odoo>
