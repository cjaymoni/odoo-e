<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pre-create the ExpressPay payment provider -->
    <record id="payment_provider_expresspay" model="payment.provider">
        <field name="name">ExpressPay Ghana</field>
        <field name="code">expresspay</field>
        <field name="state">test</field>
        <field name="is_published">True</field>
        <field name="allow_tokenization">False</field>
        <field name="allow_express_checkout">False</field>
        <field name="pre_msg">Pay securely using ExpressPay Ghana</field>
        <field name="pending_msg">Your payment is being processed by ExpressPay</field>
        <field name="auth_msg">Payment authorized successfully via ExpressPay</field>
        <field name="done_msg">Payment completed successfully via ExpressPay</field>
        <field name="cancel_msg">Payment was cancelled</field>
        <field name="image_128" type="base64" file="expresspay_ghana/static/description/icon3.jpg"/>
        
        <!-- ExpressPay specific credentials -->
        <field name="expresspay_merchant_id">173074999996</field>
        <field name="expresspay_api_key">IebQBpLCDgBkeiobGZCA1-9KQiV9WEHrRZzdy5cNCK-VOmlmJsrGzYScg5R8CcY-oqkgP5AITUxx4YEDWSz</field>
        <field name="expresspay_base_url">https://localhost:8069</field>
        <field name="expresspay_enable_webhooks">True</field>
        <field name="expresspay_fallback_polling">False</field>
        
        
        <!-- Set available currencies -->
        <field name="available_currency_ids" eval="[(6, 0, [ref('base.GHS')])]"/>
        
      
    </record>

    <!-- Create payment method for ExpressPay -->
    <record id="payment_method_expresspay" model="payment.method">
        <field name="name">ExpressPay</field>
        <field name="code">expresspay</field>
        <field name="provider_ids" eval="[(6, 0, [ref('payment_provider_expresspay')])]"/>
        <field name="image"  type="base64" file="expresspay_ghana/static/description/icon1.png"/>
    </record>

  <record id="payment_method_expresspay_bank" model="account.payment.method" forcecreate="False">
        <field name="name">ExpressPay Ghana</field>
        <field name="code">expresspay</field>
        <field name="payment_type">inbound</field>
    </record>
</odoo>